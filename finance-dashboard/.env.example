# ──────────────────────────────────────────────────────────────────
# Finance Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────

# Plaid credentials (get from https://dashboard.plaid.com)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here
PLAID_ENV=sandbox          # sandbox | development | production

# Fernet encryption key for storing Plaid access tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./finance.db

# Backend bind address — keep 127.0.0.1 for local-only security
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend dev server
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
